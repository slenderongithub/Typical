// NoLook data model — PostgreSQL. The app runs fully in guest mode without
// this database; configure DATABASE_URL to enable accounts + leaderboards.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth.js standard models ────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  displayName   String?
  settings      Json?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  results       TestResult[]
  personalBests PersonalBest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── NoLook domain ──────────────────────────────────────────────────────

model TestResult {
  id                  String   @id @default(cuid())
  userId              String?
  mode                String
  config              Json
  configKey           String
  wpmRaw              Float
  wpmCorrect          Float
  accuracy            Float
  consistency         Float
  charStats           Json
  durationMs          Int
  timeline            Json
  integrityStatus     String // clean | assisted | untracked
  peekCount           Int      @default(0)
  peekTotalMs         Int      @default(0)
  trackingLostMs      Int      @default(0)
  leaderboardEligible Boolean  @default(false)
  createdAt           DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([configKey, wpmCorrect(sort: Desc)])
  @@index([userId, createdAt])
  @@index([leaderboardEligible, configKey, createdAt])
}

model PersonalBest {
  id         String   @id @default(cuid())
  userId     String
  configKey  String
  wpm        Float
  resultId   String
  achievedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, configKey])
}
